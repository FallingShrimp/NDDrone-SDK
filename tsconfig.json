{
    "compilerOptions": {
        "target": "ESNext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "outDir": "cli/dist",
        "types": [
            "node"
        ],
        "resolveJsonModule": true
    },
    "include": [
        "cli/src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}